{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LlamachantTechnology/LlamaTree-Themes/schema/theme.schema.json",
  "title": "LlamaTree theme (themes/<id>.json)",
  "description": "Colours for LlamaTree and a few effects it knows. The id is the file's name: letters, digits and hyphens. A floor of the theme's own is a script in themes/<id>.floor.js beside it, not a value here (see CONTRIBUTING.md); a theme with one needs minAppVersion 1.3.2 or later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Shown in the theme menu and in Get themes."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "major.minor.patch. Raise it with every change: installed copies are offered the update."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "One sentence on how it looks, shown in Get themes."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "The oldest LlamaTree it works with; older copies show it but don't install it."
    },
    "base": {
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark",
      "description": "What fills in every colour it leaves out, and what Claude and plugins are told."
    },
    "font": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 \\-]{0,59}$",
      "description": "A font family for the app's own text (not the terminals')."
    },
    "glow": {
      "type": "boolean",
      "description": "Text glows faintly in the accent colour."
    },
    "grid": {
      "type": "boolean",
      "description": "The window's floor is ruled in faint lines of the accent colour."
    },
    "rain": {
      "type": "boolean",
      "description": "Glyphs rain down the window's floor in the accent colour."
    },
    "monochrome": {
      "type": "boolean",
      "description": "Everything in shades of the accent colour, built by the app."
    },
    "cursor": {
      "const": "light-cycle",
      "description": "The terminals' cursor leaves a ribbon of light behind it."
    },
    "terminalBackground": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "How solid the terminals start over the window's floor, and that the user may change it."
    },
    "accent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "strong"
      ],
      "description": "Its own accent, in place of the one picked.",
      "properties": {
        "line": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))$",
          "description": "Lines, ticks and highlights."
        },
        "strong": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))$",
          "description": "Fills that carry white text."
        }
      }
    },
    "accents": {
      "type": "array",
      "maxItems": 8,
      "description": "Accent colours it suggests.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "color"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "description": "The app's own colours: its stylesheet's variables without the dashes.",
      "properties": {
        "chrome": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))$"
        },
        "chrome-2": {
          "type": "string",
          "pattern": "^(?:#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(?:,\\s*(?:0|1|0?\\.\\d+)\\s*)?\\))$"
        },
