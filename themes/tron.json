{
  "name": "Tron",
  "version": "1.2.1",
  "minAppVersion": "1.3.4",
  "description": "The Grid: near-black ruled with light-lines in your accent colour, with a glow, a light cycle as the cursor and another running the Grid's lines across the window's floor",
  "author": "Llamachant Technology",
  "base": "dark",
  "font": "Bahnschrift",
  "glow": true,
  "terminalBackground": 85,
  "cursor": "light-cycle",
  "cycle": {
    "size": 1,
    "offset": 0
  },
  "monochrome": true,
  "accents": [
    {
      "name": "Tron",
      "color": "#00e5ff"
    },
    {
      "name": "Redline",
      "color": "#ff3b3b"
    }
  ],
  "colors": {
    "ok": "#3fe0a8",
    "attention": "#ffe066",
    "asking": "#ff8c1a",
    "danger": "#ff4d3a",
    "danger-fill": "#8a2318",
    "st-m": "#ffa21f",
    "st-a": "#3fe0a8",
    "st-d": "#ff4d3a",
    "st-r": "#8dffd2",
    "st-u": "#ffd166",
    "error-bg": "#2a0f12",
    "error-border": "#7a2a2a",
    "pv-warn-bg": "#2a1e08",
    "pv-warn-border": "#6b5520",
    "ico-folder": "#ffa21f",
    "ref-tag-bg": "#3a2a08",
    "ref-tag-fg": "#ffd9a0"
  },
  "terminal": {
    "red": "#ff4d3a",
    "green": "#3fe0a8",
    "yellow": "#ffa21f",
    "blue": "#1f93b3",
    "magenta": "#c77dff",
    "cyan": "#00e5ff",
    "brightRed": "#ff7a6b",
    "brightGreen": "#8dffd2",
    "brightYellow": "#ffd166",
    "brightBlue": "#4fd8ff",
    "brightMagenta": "#e0a8ff",
    "brightCyan": "#9ff4ff",
    "brightWhite": "#ffffff"
  },
  "diff": {
    "insertedLine": "#0f5a4a55",
    "insertedText": "#15a08066",
    "removedLine": "#6a1f1f55",
    "removedText": "#b0302e66",
    "insertedGutter": "#0f5a4a99",
    "removedGutter": "#6a1f1f99",
    "insertedOverview": "#3fe0a8cc",
    "removedOverview": "#ff4d3acc",
    "string": "#ffa21f",
    "number": "#8dffd2"
  }
